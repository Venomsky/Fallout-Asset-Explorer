<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FalloutAssetExplorer.App.Views"
    x:Class="FalloutAssetExplorer.App.Views.MapInspectorView">
  <Border Background="#20242B">
    <Grid
        x:Name="MapInspectorLayoutGrid"
        RowDefinitions="*,6,*"
        RowSpacing="4"
        MinHeight="162">
      <Grid
          x:Name="MapViewportGrid"
          Grid.Row="0"
          RowDefinitions="*,Auto"
          RowSpacing="4"
          MinHeight="56">
        <Border Grid.Row="0" Background="#171A1F" ClipToBounds="True" MinHeight="32">
          <Grid>
            <local:MapGridDiagnosticView
                Values="{Binding SelectedMapGridValues}"
                SelectedIndex="{Binding SelectedMapGridIndex, Mode=TwoWay}"
                CellInspected="MapGridView_CellInspected"
                CellSelected="MapGridView_CellSelected"
                IsHitTestVisible="True"
                IsVisible="{Binding IsMapSquareGridVisible}"
                AutomationProperties.Name="MAP raw tile-grid diagnostic" />
            <local:MapFloorTileDiagnosticView
                x:Name="MapFloorTileView"
                Values="{Binding SelectedMapGridValues}"
                TileBitmaps="{Binding MapFloorTileBitmaps}"
                UnavailableFloorIds="{Binding UnavailableMapFloorIds}"
                Placements="{Binding MapObjectPlacements}"
                Elevation="{Binding MapInspector.SelectedMapElevationIndex}"
                SelectedObject="{Binding MapInspector.SelectedMapObject, Mode=OneWay}"
                SelectedIndex="{Binding SelectedMapGridIndex, Mode=TwoWay}"
                CellInspected="MapGridView_CellInspected"
                CellSelected="MapGridView_CellSelected"
                ObjectSelected="MapFloorTileView_ObjectSelected"
                RenderOptions.BitmapInterpolationMode="None"
                IsHitTestVisible="True"
                IsVisible="{Binding IsMapFloorTileLayerVisible}"
                AutomationProperties.Name="MAP floor tiles 100 by 100 diagnostic" />
            <local:MapIsometricFloorView
                x:Name="MapIsometricFloorView"
                Values="{Binding SelectedMapGridValues}"
                TileBitmaps="{Binding MapFloorTileBitmaps}"
                AssetRevision="{Binding MapFloorTilesRevision}"
                Placements="{Binding MapInspector.FilteredMapObjectPlacements}"
                Elevation="{Binding MapInspector.SelectedMapElevationIndex}"
                ShowObjectMarkers="{Binding IsMapIsometricObjectMarkerLayerVisible}"
                ShowObjectSprites="{Binding IsMapIsometricViewVisible}"
                SelectedRecordIndex="{Binding MapInspector.SelectedMapObjectRecordIndex}"
                SelectedObjectSprite="{Binding SelectedMapObjectSprite}"
                ObjectSprites="{Binding MapObjectSprites}"
                ObjectSelectionChanged="MapIsometricFloorView_ObjectSelectionChanged"
                RenderOptions.BitmapInterpolationMode="None"
                IsHitTestVisible="True"
                IsVisible="{Binding IsMapIsometricViewVisible}"
                AutomationProperties.Name="Isometric MAP floor tiles and object markers" />
            <local:MapHexGridDiagnosticView
                x:Name="MapHexGridView"
                Placements="{Binding MapObjectPlacements}"
                Elevation="{Binding MapInspector.SelectedMapElevationIndex}"
                SelectedObject="{Binding MapInspector.SelectedMapObject, Mode=TwoWay}"
                IsHitTestVisible="True"
                IsVisible="{Binding IsMapHexGridVisible}"
                AutomationProperties.Name="MAP object hex-grid diagnostic" />
            <TextBlock
                Margin="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="This MAP has no square-grid data for this elevation."
                TextWrapping="Wrap"
                IsVisible="{Binding IsMapGridEmpty}" />
            <TextBlock
                Margin="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="This MAP has no square-grid data for this elevation."
                TextWrapping="Wrap"
                IsVisible="{Binding IsMapFloorTileLayerEmpty}" />
            <TextBlock
                Margin="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="This MAP has no square-grid data for this elevation."
                TextWrapping="Wrap"
                IsVisible="{Binding IsMapIsometricFloorLayerEmpty}" />
            <TextBlock
                Margin="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="No placed objects are available on this elevation."
                TextWrapping="Wrap"
                IsVisible="{Binding MapInspector.IsMapHexGridEmpty}" />
          </Grid>
        </Border>
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
          <TextBlock VerticalAlignment="Center" Text="Layer" />
          <ComboBox
              Width="175"
              ItemsSource="{Binding MapInspector.MapDiagnosticLayerOptions}"
              SelectedIndex="{Binding MapInspector.SelectedMapDiagnosticLayerIndex}"
              SelectionChanged="MapDiagnosticLayer_SelectionChanged"
              AutomationProperties.Name="MAP diagnostic layer" />
          <TextBlock VerticalAlignment="Center" Text="Elevation" />
          <ComboBox
              Width="75"
              ItemsSource="{Binding MapInspector.MapElevationOptions}"
              SelectedItem="{Binding MapInspector.SelectedMapElevationIndex}"
              IsEnabled="{Binding IsMapInspector}"
              AutomationProperties.Name="MAP elevation slot" />
          <Button
              Content="Fit"
              Click="MapHexFit_Click"
              IsVisible="{Binding IsMapHexGridVisible}"
              ToolTip.Tip="Fit placed objects of this elevation (wheel: zoom, right/middle drag: pan)"
              AutomationProperties.Name="Fit hex view" />
          <Button
              Content="Fit"
              Click="MapFloorFit_Click"
              IsVisible="{Binding IsMapFloorTileLayerVisible}"
              ToolTip.Tip="Fit the complete 100 by 100 floor grid (wheel: zoom, right/middle drag: pan)"
              AutomationProperties.Name="Fit floor tile grid" />
          <Button
              Content="Fit"
              Click="MapIsometricFloorFit_Click"
              IsVisible="{Binding IsMapIsometricViewVisible}"
              ToolTip.Tip="Fit the isometric floor tiles and object markers (wheel: zoom, right/middle drag: pan)"
              AutomationProperties.Name="Fit isometric view" />
          <Button
              Content="Center"
              Click="MapHexCenter_Click"
              IsVisible="{Binding IsMapHexGridVisible}"
              ToolTip.Tip="Center the selected object"
              AutomationProperties.Name="Center on selected object" />
          <Button
              x:Name="MapRecordsToggleButton"
              Content="Hide records"
              Click="ToggleMapRecords_Click"
              AutomationProperties.Name="Hide MAP object records" />
          <Button
              x:Name="MapWorkspaceToggleButton"
              Content="Hide workspace"
              Click="ToggleMapWorkspace_Click"
              AutomationProperties.Name="Hide MAP details and records" />
          <Button
              x:Name="MapMaximizeButton"
              Content="Maximize map"
              Click="ToggleMapMaximized_Click"
              AutomationProperties.Name="Maximize MAP view" />
        </StackPanel>
      </Grid>
      <GridSplitter
          x:Name="MapWorkspaceSplitter"
          Grid.Row="1"
          Height="6"
          HorizontalAlignment="Stretch"
          Background="#3A414C"
          ResizeDirection="Rows"
          ResizeBehavior="PreviousAndNext"
          AutomationProperties.Name="Resize MAP canvas and inspector workspace" />
      <Grid
          x:Name="InspectorWorkspaceGrid"
          Grid.Row="2"
          RowDefinitions="*,6,*"
          RowSpacing="4"
          MinHeight="100">
        <ScrollViewer
            x:Name="MapMetadataScrollViewer"
            Grid.Row="0"
            MinHeight="32"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <TextBlock
                Foreground="#AAB2BF"
                FontSize="12"
                Text="{Binding PreviewDetails}"
                TextWrapping="Wrap" />
            <Border
                Padding="6"
                Background="#20242B"
                BorderBrush="#343A44"
                BorderThickness="1"
                CornerRadius="4"
                AutomationProperties.Name="Selected MAP object details">
              <StackPanel Spacing="4">
                <TextBlock
                    Foreground="#AAB2BF"
                    FontSize="10"
                    Text="{Binding MapInspector.EditSessionStatusDisplay}"
                    IsVisible="{Binding MapInspector.HasEditSession}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="#E7EAF0"
                    FontSize="11"
                    Text="{Binding MapInspector.MapObjectDetailsDisplay}"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock
                Foreground="#E7EAF0"
                FontSize="12"
                Text="{Binding MapGridCellDisplay}"
                IsVisible="{Binding IsMapSquareGridVisible}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="#E7EAF0"
                FontSize="12"
                Text="{Binding MapGridCellDisplay}"
                IsVisible="{Binding IsMapFloorTileLayerVisible}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="#AAB2BF"
                FontSize="12"
                Text="{Binding MapGridHoverDisplay}"
                IsVisible="{Binding IsMapSquareGridVisible}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="#AAB2BF"
                FontSize="12"
                Text="Hex markers are diagnostic only; repeat-click stacked markers to cycle records."
                IsVisible="{Binding IsMapHexGridVisible}"
                TextWrapping="Wrap" />
            <StackPanel
                IsVisible="{Binding IsMapFloorTileLayerVisible}"
                Spacing="2">
              <TextBlock
                  Foreground="#AAB2BF"
                  FontSize="12"
                  Text="{Binding MapFloorTilesStatusDisplay}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Foreground="#AAB2BF"
                  FontSize="11"
                  Text="Colored markers show the square floor cell sampled by CE gravity; click to select, repeat-click to cycle stacked objects."
                  TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                Foreground="#AAB2BF"
                FontSize="12"
                Text="{Binding MapFloorTilesStatusDisplay}"
                IsVisible="{Binding IsMapIsometricFloorLayerVisible}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="#AAB2BF"
                FontSize="12"
                Text="{Binding #MapIsometricFloorView.SpriteRenderDiagnosticDisplay}"
                IsVisible="{Binding IsMapIsometricViewVisible}"
                TextWrapping="Wrap" />
            <StackPanel
                IsVisible="{Binding IsMapIsometricViewVisible}"
                Spacing="2">
              <TextBlock
                  Foreground="#AAB2BF"
                  FontSize="12"
                  Text="{Binding MapObjectSpriteStatusDisplay}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Foreground="#AAB2BF"
                  FontSize="12"
                  Text="{Binding MapObjectSpritesStatusDisplay}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Foreground="#AAB2BF"
                  FontSize="11"
                  Text="Anchor follows the audited CE tile, art-shift, MAP-offset, and frame-dimension formula; global object ordering is not reproduced."
                  TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                Foreground="#AAB2BF"
                FontSize="12"
                Text="{Binding PaletteStatus}"
                TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        <GridSplitter
            Grid.Row="1"
            Height="6"
            HorizontalAlignment="Stretch"
            Background="#3A414C"
            ResizeDirection="Rows"
            ResizeBehavior="PreviousAndNext"
            AutomationProperties.Name="Resize MAP metadata and object workspace" />
        <Grid
            x:Name="RecordPrototypeGrid"
            Grid.Row="2"
            RowDefinitions="*,6,*"
            RowSpacing="4"
            MinHeight="76">
          <Grid
              x:Name="MapRecordsPane"
              Grid.Row="0"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="4"
              MinHeight="32">
            <TextBlock
                Foreground="#E7EAF0"
                FontWeight="SemiBold"
                Text="{Binding MapObjectStatusDisplay}"
                TextWrapping="Wrap" />
            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                ColumnSpacing="6">
              <ComboBox
                  Width="150"
                  ItemsSource="{Binding MapInspector.MapObjectTypeFilterOptions}"
                  SelectedItem="{Binding MapInspector.SelectedMapObjectTypeFilter, Mode=TwoWay}"
                  AutomationProperties.Name="Filter MAP objects by type">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox
                  Grid.Column="1"
                  Width="190"
                  ItemsSource="{Binding MapInspector.MapObjectListSortOptions}"
                  SelectedItem="{Binding MapInspector.SelectedMapObjectListSort, Mode=TwoWay}"
                  AutomationProperties.Name="Sort MAP object records">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox
                  Grid.Column="2"
                  Watermark="Search MAP objects..."
                  Text="{Binding MapInspector.MapObjectSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  AutomationProperties.Name="Search MAP object metadata" />
              <TextBlock
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="#AAB1BE"
                  Text="{Binding MapInspector.MapObjectSearchResultCountDisplay}"
                  AutomationProperties.Name="MAP object search result count" />
              <Button
                  Grid.Column="4"
                  Content="Clear search"
                  Click="ClearMapObjectSearch_Click"
                  AutomationProperties.Name="Clear MAP object text search" />
            </Grid>
            <Grid Grid.Row="2">
              <ListBox
                  ItemsSource="{Binding MapInspector.SortedMapObjectPlacements}"
                  SelectedItem="{Binding MapInspector.SelectedMapObject, Mode=TwoWay}"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="MAP object placements">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <local:MapObjectSearchHighlightTextBlock
                        DisplayText="{Binding DisplayText}"
                        SearchText="{Binding DataContext.MapInspector.MapObjectSearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                        TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border
                  Background="#20242B"
                  BorderBrush="#343A44"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="8"
                  IsVisible="{Binding MapInspector.HasNoMatchingMapObjects}"
                  AutomationProperties.Name="No matching MAP objects">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#AAB1BE"
                    FontSize="11"
                    Text="No matching objects" />
              </Border>
            </Grid>
          </Grid>
          <GridSplitter
              Grid.Row="1"
              Height="6"
              HorizontalAlignment="Stretch"
              Background="#3A414C"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              AutomationProperties.Name="Resize MAP records and prototype diagnostics" />
          <Expander
              x:Name="MapPrototypeExpander"
              Grid.Row="2"
              Header="Fallout 2 prototype (.PRO)"
              IsExpanded="True"
              MinHeight="36"
              VerticalAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              AutomationProperties.Name="Selected object's Fallout 2 prototype diagnostics">
            <Grid
                RowDefinitions="*,6,*"
                RowSpacing="4"
                VerticalAlignment="Stretch">
              <ScrollViewer
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">
                  <TextBlock
                      Foreground="#AAB1BE"
                      FontSize="11"
                      Text="{Binding MapInspector.MapObjectPrototypeDiagnosticStatus}"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Foreground="#E7EAF0"
                      FontFamily="Consolas"
                      FontSize="10"
                      Text="{Binding MapInspector.MapObjectPrototypeDiagnosticDetails}"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Foreground="#E7EAF0"
                      FontFamily="Consolas"
                      FontSize="9"
                      IsVisible="{Binding MapInspector.HasMapObjectPrototypeSceneryFields}"
                      Text="{Binding MapInspector.MapObjectPrototypeSceneryFieldsDisplay}"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Foreground="#E7EAF0"
                      FontFamily="Consolas"
                      FontSize="9"
                      IsVisible="{Binding MapInspector.HasMapObjectPrototypeItemFields}"
                      Text="{Binding MapInspector.MapObjectPrototypeItemFieldsDisplay}"
                      TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
              <GridSplitter
                  Grid.Row="1"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  Background="#3A414C"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  AutomationProperties.Name="Resize prototype fields and raw bytes" />
              <ListBox
                  Grid.Row="2"
                  ItemsSource="{Binding MapInspector.MapObjectPrototypeRawByteLines}"
                  IsVisible="{Binding MapInspector.HasMapObjectPrototypeRawBytes}"
                  VerticalAlignment="Stretch"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Raw selected prototype bytes">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="9"
                        Text="{Binding}"
                        TextWrapping="NoWrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Expander>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
