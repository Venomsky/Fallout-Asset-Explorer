<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FalloutAssetExplorer.App.Views"
    x:Class="FalloutAssetExplorer.App.Views.SpriteExplorerView">
  <Grid Margin="8" RowDefinitions="Auto,*,Auto" RowSpacing="8">
    <Border
        Grid.Row="0"
        Padding="10,7"
        Background="#20242B"
        BorderBrush="#343A44"
        BorderThickness="1"
        CornerRadius="4">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Button
            Content="Open DAT archive..."
            Click="OpenArchive_Click"
            IsEnabled="{Binding CanOpenArchive}" />
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Text="{Binding SourceArchiveDisplay}"
            TextTrimming="CharacterEllipsis"
            AutomationProperties.Name="Sprite Explorer source archive" />
        <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            Text="{Binding StatusMessage}"
            TextTrimming="CharacterEllipsis"
            AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </Border>

    <Grid
        x:Name="SpriteWorkspace"
        Grid.Row="1"
        ColumnDefinitions="240,6,*,6,250"
        ColumnSpacing="4"
        MinHeight="160">
      <Border
          x:Name="AssetBrowserPanel"
          Grid.Column="0"
          MinWidth="200"
          Padding="10"
          Background="#20242B"
          BorderBrush="#343A44"
          BorderThickness="1"
          CornerRadius="4">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
          <TextBlock
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="#AAB2BF"
              Text="ASSET BROWSER" />
          <TextBox
              Grid.Row="1"
              Watermark="Search FRM paths..."
              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
              AutomationProperties.Name="Search FRM paths" />
          <ComboBox
              Grid.Row="2"
              ItemsSource="{Binding ArchiveLocationOptions}"
              SelectedItem="{Binding SelectedArchiveLocation}"
              AutomationProperties.Name="Filter FRMs by archive location" />
          <ListBox
              x:Name="SpriteAssetList"
              Grid.Row="3"
              ItemsSource="{Binding VisibleEntries}"
              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
              AutomationProperties.Name="FRM entries in the source archive">
            <ListBox.Styles>
              <Style Selector="ListBoxItem:selected">
                <Setter Property="Background" Value="#3B536F" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,4" Spacing="2">
                  <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                  <TextBlock
                      Foreground="#AAB2BF"
                      FontSize="11"
                      Text="{Binding ArchiveLocation}"
                      TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border
              Grid.Row="3"
              Padding="12"
              Background="#20242B"
              IsVisible="{Binding IsFilterResultEmpty}"
              IsHitTestVisible="False"
              AutomationProperties.Name="No FRM entries match the current filters">
            <TextBlock Text="No FRM entries match the current filters." />
          </Border>
        </Grid>
      </Border>

      <GridSplitter
          x:Name="AssetBrowserSplitter"
          Grid.Column="1"
          Width="6"
          HorizontalAlignment="Stretch"
          Background="#3A414C"
          ResizeDirection="Columns"
          ResizeBehavior="PreviousAndNext"
          AutomationProperties.Name="Resize asset browser and sprite viewport" />

      <Border
          x:Name="SpriteViewportPanel"
          Grid.Column="2"
          MinWidth="240"
          Padding="8"
          Background="#20242B"
          BorderBrush="#343A44"
          BorderThickness="1"
          CornerRadius="4">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
            <RadioButton
                GroupName="SpritePreviewMode"
                Content="Animation"
                IsChecked="{Binding IsAnimationMode, Mode=TwoWay}" />
            <RadioButton
                GroupName="SpritePreviewMode"
                Content="Sprite Sheet"
                IsChecked="{Binding IsSpriteSheetMode, Mode=TwoWay}" />
            <ComboBox
                Width="110"
                ItemsSource="{Binding Preview.DirectionOptions}"
                SelectedIndex="{Binding Preview.SelectedDirectionIndex}"
                AutomationProperties.Name="Sprite direction" />
            <ComboBox
                Width="78"
                ItemsSource="{Binding Preview.FrameOptions}"
                SelectedItem="{Binding Preview.SelectedFrameIndex}"
                AutomationProperties.Name="Sprite frame" />
            <CheckBox
                Content="Checkerboard"
                IsChecked="{Binding Preview.IsCheckerboardBackground}"
                AutomationProperties.Name="Sprite transparency background" />
            <CheckBox
                Content="All Directions"
                IsChecked="{Binding IsAllDirectionsSpriteSheet}"
                IsVisible="{Binding IsSpriteSheetMode}"
                IsEnabled="{Binding HasSpriteSheetSource}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding SpriteSheetSummary}"
                TextTrimming="CharacterEllipsis"
                IsVisible="{Binding IsSpriteSheetMode}" />
          </WrapPanel>

          <WrapPanel
              Grid.Row="1"
              Orientation="Horizontal"
              ItemSpacing="4"
              LineSpacing="4">
            <Button Content="+" Click="ZoomIn_Click" IsEnabled="{Binding Zoom.HasImage}" />
            <Button Content="−" Click="ZoomOut_Click" IsEnabled="{Binding Zoom.HasImage}" />
            <Button Content="100%" Click="Zoom100_Click" IsEnabled="{Binding Zoom.HasImage}" />
            <Button
                x:Name="ZoomFitButton"
                Content="Fit"
                Click="ZoomFit_Click"
                IsEnabled="{Binding Zoom.HasImage}" />
            <TextBlock
                VerticalAlignment="Center"
                MinWidth="48"
                Text="{Binding Zoom.ZoomDisplay}"
                TextAlignment="Right"
                AutomationProperties.Name="Sprite zoom percentage" />
            <Button
                x:Name="ExportFrameButton"
                Content="Frame PNG"
                Click="ExportCurrentFrame_Click"
                IsEnabled="{Binding CanExportCurrentFrame}"
                ToolTip.Tip="Export the current frame as PNG" />
            <Button
                x:Name="ExportDirectionButton"
                Content="Direction PNG"
                Click="ExportCurrentDirection_Click"
                IsEnabled="{Binding CanExportCurrentDirection}"
                ToolTip.Tip="Export the current direction as a PNG spritesheet" />
            <Button
                x:Name="ExportAllDirectionsButton"
                Content="All PNG"
                Click="ExportAllDirections_Click"
                IsEnabled="{Binding CanExportAllDirections}"
                ToolTip.Tip="Export all directions as a PNG spritesheet" />
            <Button
                x:Name="ExportVisibleSpriteSheetButton"
                Content="Sheet PNG"
                Click="ExportVisibleSpriteSheet_Click"
                IsEnabled="{Binding CanExportVisibleSpriteSheet}"
                IsVisible="{Binding IsSpriteSheetMode}" />
            <Button
                Content="Cancel export"
                Click="CancelExport_Click"
                IsVisible="{Binding IsExporting}"
                IsEnabled="{Binding CanCancelExport}" />
          </WrapPanel>

          <Border
              x:Name="SpriteViewportBorder"
              Grid.Row="2"
              Background="#171A1F"
              ClipToBounds="True"
              MinHeight="80">
            <Grid IsVisible="{Binding HasDisplayBitmap}">
              <local:CheckerboardBackground
                  IsVisible="{Binding Preview.IsCheckerboardBackground}"
                  IsHitTestVisible="False" />
              <Grid
                  x:Name="SpriteViewport"
                  Background="Transparent"
                  ClipToBounds="True"
                  SizeChanged="SpriteViewport_SizeChanged"
                  PointerWheelChanged="SpriteViewport_PointerWheelChanged"
                  PointerPressed="SpriteViewport_PointerPressed"
                  PointerMoved="SpriteViewport_PointerMoved"
                  PointerReleased="SpriteViewport_PointerReleased"
                  PointerCaptureLost="SpriteViewport_PointerCaptureLost">
                <Grid
                    x:Name="SpriteContent"
                    Background="Transparent"
                    RenderTransformOrigin="0%, 0%">
                  <Image
                      x:Name="SpriteImage"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Source="{Binding DisplayBitmap}"
                      Stretch="None"
                      RenderOptions.BitmapInterpolationMode="None"
                      AutomationProperties.Name="Sprite frame preview" />
                  <local:SpriteSheetFrameOverlay
                      x:Name="SpriteSheetFrameOverlay"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      IsVisible="{Binding IsSpriteSheetMode}"
                      IsHitTestVisible="False"
                      Width="{Binding SpriteSheetWidth}"
                      Height="{Binding SpriteSheetHeight}"
                      ClipToBounds="True" />
                </Grid>
              </Grid>
            </Grid>
          </Border>

          <TextBlock
              x:Name="SpriteSheetStatusText"
              Grid.Row="3"
              Foreground="#AAB2BF"
              FontSize="11"
              Text="{Binding SpriteSheetStatus}"
              TextWrapping="Wrap"
              IsVisible="{Binding IsSpriteSheetMode}" />
        </Grid>
      </Border>

      <GridSplitter
          x:Name="PropertiesSplitter"
          Grid.Column="3"
          Width="6"
          HorizontalAlignment="Stretch"
          Background="#3A414C"
          ResizeDirection="Columns"
          ResizeBehavior="PreviousAndNext"
          AutomationProperties.Name="Resize sprite viewport and properties" />

      <Border
          x:Name="PropertiesPanel"
          Grid.Column="4"
          MinWidth="210"
          Padding="8"
          Background="#20242B"
          BorderBrush="#343A44"
          BorderThickness="1"
          CornerRadius="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Properties" />
            <Border Padding="8" Background="#252A33" CornerRadius="4">
              <StackPanel Spacing="4">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#AAB2BF" Text="ASSET" />
                <TextBlock Text="{Binding SelectedEntryDisplay}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                  <TextBlock Foreground="#AAB2BF" Text="Archive" />
                  <TextBlock Grid.Column="1" Text="{Binding SourceArchiveDisplay}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Foreground="#AAB2BF" Text="FRM version" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview.FrmVersionDisplay}" />
                  <TextBlock Grid.Row="2" Foreground="#AAB2BF" Text="Byte size" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEntrySizeDisplay}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Padding="8" Background="#252A33" CornerRadius="4">
              <StackPanel Spacing="4">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#AAB2BF" Text="FRAME" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                  <TextBlock Foreground="#AAB2BF" Text="Direction" />
                  <TextBlock Grid.Column="1" Text="{Binding Preview.CurrentDirectionDisplay}" />
                  <TextBlock Grid.Row="1" Foreground="#AAB2BF" Text="Frame" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview.CurrentFrameDisplay}" />
                  <TextBlock Grid.Row="2" Foreground="#AAB2BF" Text="Dimensions" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Preview.FrameDimensionsDisplay}" />
                  <TextBlock Grid.Row="3" Foreground="#AAB2BF" Text="Frame offset" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Preview.FrameOffsetDisplay}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Padding="8" Background="#252A33" CornerRadius="4">
              <StackPanel Spacing="4">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#AAB2BF" Text="ANIMATION" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                  <TextBlock Foreground="#AAB2BF" Text="FRM rate metadata" />
                  <TextBlock Grid.Column="1" Text="{Binding Preview.FrmRateMetadataDisplay}" />
                  <TextBlock Grid.Row="1" Foreground="#AAB2BF" Text="Action frame" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview.ActionFrameDisplay}" />
                  <TextBlock Grid.Row="2" Foreground="#AAB2BF" Text="Playback FPS" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Preview.PlaybackSpeedDisplay}" />
                  <TextBlock Grid.Row="3" Foreground="#AAB2BF" Text="Loop" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Preview.LoopStateDisplay}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Padding="8" Background="#252A33" CornerRadius="4">
              <StackPanel Spacing="4">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#AAB2BF" Text="RENDERING" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                  <TextBlock Foreground="#AAB2BF" Text="Direction shift" />
                  <TextBlock Grid.Column="1" Text="{Binding Preview.DirectionShiftDisplay}" />
                  <TextBlock Grid.Row="1" Foreground="#AAB2BF" Text="Palette source" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PaletteStatus}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Foreground="#AAB2BF" Text="Transparency" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Preview.TransparencyDisplay}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock
                    Foreground="#AAB2BF"
                    FontSize="11"
                    Text="Sprite sheets use raw frame bounds; FRM offsets and direction shifts are stored in PNG metadata."
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border
        Grid.Row="2"
        Padding="8,5"
        Background="#20242B"
        BorderBrush="#343A44"
        BorderThickness="1"
        CornerRadius="4">
      <Grid ColumnDefinitions="Auto,Auto,Auto,130,*,Auto,Auto" ColumnSpacing="8">
        <Button
            Content="{Binding Preview.PlayPauseButtonText}"
            Click="TogglePlayback_Click"
            IsEnabled="{Binding Preview.CanPlay}"
            AutomationProperties.Name="Play or pause sprite animation" />
        <CheckBox
            Grid.Column="1"
            VerticalAlignment="Center"
            Content="Loop"
            IsChecked="{Binding Preview.IsLoopEnabled}"
            IsEnabled="{Binding Preview.CanPlay}" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Playback FPS" />
        <Slider
            Grid.Column="3"
            Minimum="1"
            Maximum="30"
            TickFrequency="1"
            IsSnapToTickEnabled="True"
            Value="{Binding Preview.PlaybackSpeed}"
            IsEnabled="{Binding Preview.CanPlay}"
            AutomationProperties.Name="Sprite animation frames per second" />
        <Slider
            x:Name="FrameTimelineSlider"
            Grid.Column="4"
            Minimum="0"
            Maximum="{Binding Preview.FrameSliderMaximum}"
            TickFrequency="1"
            IsSnapToTickEnabled="True"
            Value="{Binding Preview.SelectedFrameIndex, Mode=TwoWay}"
            IsEnabled="{Binding Preview.HasPreview}"
            AutomationProperties.Name="Sprite animation frame timeline" />
        <TextBlock
            Grid.Column="5"
            VerticalAlignment="Center"
            Text="{Binding Preview.PlaybackSpeedDisplay}" />
        <TextBlock
            Grid.Column="6"
            VerticalAlignment="Center"
            Text="{Binding Preview.CurrentFrameDisplay}"
            AutomationProperties.Name="Current sprite frame position" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
