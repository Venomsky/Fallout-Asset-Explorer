<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FalloutAssetExplorer.App.Views"
    x:Class="FalloutAssetExplorer.App.Views.MainWindow"
    Title="Fallout Asset Explorer"
    Width="1120"
    Height="720"
    MinWidth="760"
    MinHeight="480"
    Background="#171A1F"
    Foreground="#E7EAF0"
    FontFamily="Segoe UI">
  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open Archive..." Click="OpenArchive_Click" IsEnabled="{Binding CanOpenArchive}" />
        <MenuItem Header="Set _Game Data Folder..." Click="SetGameDataFolder_Click" />
        <MenuItem Header="_Extract Selected..." Click="ExtractSelected_Click" IsEnabled="{Binding CanExtractSelected}" />
        <MenuItem Header="Extract _Visible..." Click="ExtractVisible_Click" IsEnabled="{Binding CanExtractVisible}" />
        <MenuItem Header="Extract _All..." Click="ExtractAll_Click" IsEnabled="{Binding CanExtractAll}" />
        <Separator />
        <MenuItem Header="Export _Selected..." IsEnabled="False" ToolTip.Tip="Available after archive reading and safe extraction are implemented." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Fallout Asset Explorer" Click="About_Click" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Padding="12,10" Background="#20242B">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Open Archive" Click="OpenArchive_Click" IsDefault="True" IsEnabled="{Binding CanOpenArchive}" />
        <Button Content="Extract Selected" Click="ExtractSelected_Click" IsEnabled="{Binding CanExtractSelected}" />
        <Button Content="Extract Visible" Click="ExtractVisible_Click" IsEnabled="{Binding CanExtractVisible}" />
        <Button Content="Extract All" Click="ExtractAll_Click" IsEnabled="{Binding CanExtractAll}" />
        <TextBlock VerticalAlignment="Center" Text="Overwrite" />
        <ComboBox
            Width="150"
            ItemsSource="{Binding OverwritePolicyOptions}"
            SelectedIndex="{Binding SelectedOverwritePolicyIndex}"
            AutomationProperties.Name="Extraction overwrite policy" />
        <Border Width="1" Margin="2,0" Background="#3A414C" />
        <TextBlock VerticalAlignment="Center" Text="Search" />
        <TextBox
            Width="280"
            Watermark="Search resource paths..."
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            AutomationProperties.Name="Search resource paths" />
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Type" />
        <ComboBox
            Width="130"
            ItemsSource="{Binding ExtensionOptions}"
            SelectedItem="{Binding SelectedExtension}"
            AutomationProperties.Name="Filter by extension" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#20242B" BorderBrush="#343A44" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,2*" ColumnSpacing="20">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Archive:" />
          <TextBlock Text="{Binding ArchivePathDisplay}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Format:" />
          <TextBlock Text="{Binding ArchiveFormatDisplay}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Entries:" />
          <TextBlock Text="{Binding EntryCountDisplay}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Selection:" />
          <TextBlock Text="{Binding SelectionDisplay}" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Game data:" />
          <TextBlock Text="{Binding GameDataDirectoryDisplay}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Margin="12,8" Padding="10,8" Background="#252A33" CornerRadius="4">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Border>

    <Grid Margin="12,0,12,8" ColumnDefinitions="2*,*" ColumnSpacing="12">
      <DataGrid
          x:Name="EntriesGrid"
          Grid.Column="0"
          ItemsSource="{Binding VisibleEntries}"
          SelectionMode="Extended"
          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
          IsReadOnly="True"
          AutoGenerateColumns="False"
          CanUserSortColumns="True"
          GridLinesVisibility="Horizontal"
          HeadersVisibility="Column"
          MinHeight="200"
          SelectionChanged="EntriesGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Resource path/name" Binding="{Binding Path}" SortMemberPath="Path" Width="3*" />
          <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" SortMemberPath="Extension" Width="*" />
          <DataGridTextColumn Header="Uncompressed size" Binding="{Binding UncompressedSize}" SortMemberPath="UncompressedSize" Width="*" />
          <DataGridTextColumn Header="Compressed size" Binding="{Binding CompressedSize}" SortMemberPath="CompressedSize" Width="*" />
          <DataGridTextColumn Header="Archive location" Binding="{Binding ArchiveLocation}" SortMemberPath="ArchiveLocation" Width="2*" />
        </DataGrid.Columns>
      </DataGrid>

      <Border
          Grid.Column="1"
          Padding="12"
          Background="#20242B"
          BorderBrush="#343A44"
          BorderThickness="1"
          CornerRadius="4">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding PreviewTitle}" />
            <Button
                Grid.Column="1"
                Content="Export PNG..."
                Click="ExportPng_Click"
                IsEnabled="{Binding CanExportPng}"
                AutomationProperties.Name="Export selected FRM frame as PNG" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding PreviewMessage}" TextWrapping="Wrap" />
          <Border Grid.Row="2" Background="#171A1F" ClipToBounds="True">
            <Grid>
              <Grid IsVisible="{Binding HasPreview}">
                <local:CheckerboardBackground
                    IsVisible="{Binding IsCheckerboardBackground}"
                    IsHitTestVisible="False" />
                <Image
                    Source="{Binding PreviewBitmap}"
                    Stretch="Uniform"
                    RenderOptions.BitmapInterpolationMode="None"
                    AutomationProperties.Name="FRM color preview" />
              </Grid>
              <local:MapGridDiagnosticView
                  MinHeight="260"
                  Values="{Binding SelectedMapGridValues}"
                  SelectedIndex="{Binding SelectedMapGridIndex, Mode=TwoWay}"
                  CellInspected="MapGridView_CellInspected"
                  CellSelected="MapGridView_CellSelected"
                  IsHitTestVisible="True"
                  IsVisible="{Binding IsMapSquareGridVisible}"
                  AutomationProperties.Name="MAP raw tile-grid diagnostic" />
              <local:MapFloorTileDiagnosticView
                  x:Name="MapFloorTileView"
                  MinHeight="260"
                  Values="{Binding SelectedMapGridValues}"
                  TileBitmaps="{Binding MapFloorTileBitmaps}"
                  UnavailableFloorIds="{Binding UnavailableMapFloorIds}"
                  Placements="{Binding MapObjectPlacements}"
                  Elevation="{Binding SelectedMapElevationIndex}"
                  SelectedObject="{Binding SelectedMapObject, Mode=OneWay}"
                  SelectedIndex="{Binding SelectedMapGridIndex, Mode=TwoWay}"
                  CellInspected="MapGridView_CellInspected"
                  CellSelected="MapGridView_CellSelected"
                  ObjectSelected="MapFloorTileView_ObjectSelected"
                  RenderOptions.BitmapInterpolationMode="None"
                  IsHitTestVisible="True"
                  IsVisible="{Binding IsMapFloorTileLayerVisible}"
                  AutomationProperties.Name="MAP floor tiles 100 by 100 diagnostic" />
              <local:MapIsometricFloorView
                  x:Name="MapIsometricFloorView"
                  MinHeight="260"
                  Values="{Binding SelectedMapGridValues}"
                  TileBitmaps="{Binding MapFloorTileBitmaps}"
                  AssetRevision="{Binding MapFloorTilesRevision}"
                  Placements="{Binding MapObjectPlacements}"
                  Elevation="{Binding SelectedMapElevationIndex}"
                  ShowObjectMarkers="{Binding IsMapIsometricObjectMarkerLayerVisible}"
                  RenderOptions.BitmapInterpolationMode="None"
                  IsHitTestVisible="True"
                  IsVisible="{Binding IsMapIsometricViewVisible}"
                  AutomationProperties.Name="Isometric MAP floor tiles and object markers" />
              <local:MapHexGridDiagnosticView
                  x:Name="MapHexGridView"
                  MinHeight="260"
                  Placements="{Binding MapObjectPlacements}"
                  Elevation="{Binding SelectedMapElevationIndex}"
                  SelectedObject="{Binding SelectedMapObject, Mode=TwoWay}"
                  IsHitTestVisible="True"
                  IsVisible="{Binding IsMapHexGridVisible}"
                  AutomationProperties.Name="MAP object hex-grid diagnostic" />
              <TextBlock
                  Margin="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Text="This MAP has no square-grid data for this elevation."
                  TextWrapping="Wrap"
                  IsVisible="{Binding IsMapGridEmpty}" />
              <TextBlock
                  Margin="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Text="This MAP has no square-grid data for this elevation."
                  TextWrapping="Wrap"
                  IsVisible="{Binding IsMapFloorTileLayerEmpty}" />
              <TextBlock
                  Margin="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Text="This MAP has no square-grid data for this elevation."
                  TextWrapping="Wrap"
                  IsVisible="{Binding IsMapIsometricFloorLayerEmpty}" />
              <TextBlock
                  Margin="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Text="No placed objects are available on this elevation."
                  TextWrapping="Wrap"
                  IsVisible="{Binding IsMapHexGridEmpty}" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPreview}">
            <TextBlock VerticalAlignment="Center" Text="Direction" />
            <ComboBox
                Width="130"
                ItemsSource="{Binding DirectionOptions}"
                SelectedIndex="{Binding SelectedDirectionIndex}"
                IsEnabled="{Binding HasPreview}"
                AutomationProperties.Name="FRM direction" />
            <TextBlock VerticalAlignment="Center" Text="Frame" />
            <ComboBox
                Width="90"
                ItemsSource="{Binding FrameOptions}"
                SelectedItem="{Binding SelectedFrameIndex}"
                IsEnabled="{Binding HasPreview}"
                AutomationProperties.Name="FRM frame" />
            <CheckBox
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Content="Checkerboard"
                IsChecked="{Binding IsCheckerboardBackground}"
                IsEnabled="{Binding HasPreview}"
                AutomationProperties.Name="Checkerboard transparency background" />
          </StackPanel>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsMapInspector}">
            <TextBlock VerticalAlignment="Center" Text="Layer" />
            <ComboBox
                Width="175"
                ItemsSource="{Binding MapDiagnosticLayerOptions}"
                SelectedIndex="{Binding SelectedMapDiagnosticLayerIndex}"
                SelectionChanged="MapDiagnosticLayer_SelectionChanged"
                AutomationProperties.Name="MAP diagnostic layer" />
            <TextBlock VerticalAlignment="Center" Text="Elevation" />
            <ComboBox
                Width="75"
                ItemsSource="{Binding MapElevationOptions}"
                SelectedItem="{Binding SelectedMapElevationIndex}"
                IsEnabled="{Binding IsMapInspector}"
                AutomationProperties.Name="MAP elevation slot" />
            <Button
                Content="Fit"
                Click="MapHexFit_Click"
                IsVisible="{Binding IsMapHexGridVisible}"
                ToolTip.Tip="Fit placed objects of this elevation (wheel: zoom, right/middle drag: pan)"
                AutomationProperties.Name="Fit hex view" />
            <Button
                Content="Fit"
                Click="MapFloorFit_Click"
                IsVisible="{Binding IsMapFloorTileLayerVisible}"
                ToolTip.Tip="Fit the complete 100 by 100 floor grid (wheel: zoom, right/middle drag: pan)"
                AutomationProperties.Name="Fit floor tile grid" />
            <Button
                Content="Fit"
                Click="MapIsometricFloorFit_Click"
                IsVisible="{Binding IsMapIsometricViewVisible}"
                ToolTip.Tip="Fit the isometric floor tiles and object markers (wheel: zoom, right/middle drag: pan)"
                AutomationProperties.Name="Fit isometric view" />
            <Button
                Content="Center"
                Click="MapHexCenter_Click"
                IsVisible="{Binding IsMapHexGridVisible}"
                ToolTip.Tip="Center the selected object"
                AutomationProperties.Name="Center on selected object" />
          </StackPanel>
          <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasPreview}">
            <Button
                Content="{Binding PlayPauseButtonText}"
                Click="TogglePlayback_Click"
                IsEnabled="{Binding CanPlay}"
                AutomationProperties.Name="Play or pause FRM animation" />
            <CheckBox
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="Loop"
                IsChecked="{Binding IsLoopEnabled}"
                IsEnabled="{Binding CanPlay}"
                AutomationProperties.Name="Loop FRM animation" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{Binding CurrentFrameDisplay}"
                AutomationProperties.Name="Current FRM frame" />
            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                Text="Preview FPS" />
            <Slider
                Grid.Column="4"
                Minimum="1"
                Maximum="30"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Value="{Binding PlaybackSpeed}"
                AutomationProperties.Name="FRM preview playback speed" />
            <TextBlock
                Grid.Column="5"
                VerticalAlignment="Center"
                Text="{Binding PlaybackSpeedDisplay}" />
          </Grid>
          <TextBlock
              Grid.Row="5"
              Foreground="#AAB2BF"
              FontSize="12"
              Text="{Binding PreviewDetails}"
              IsVisible="{Binding HasPreview}"
              TextWrapping="Wrap" />
          <TextBlock
              Grid.Row="5"
              Foreground="#E7EAF0"
              FontSize="12"
              Text="{Binding MapGridCellDisplay}"
              IsVisible="{Binding IsMapSquareGridVisible}"
              TextWrapping="Wrap" />
          <TextBlock
              Grid.Row="5"
              Foreground="#E7EAF0"
              FontSize="12"
              Text="{Binding MapGridCellDisplay}"
              IsVisible="{Binding IsMapFloorTileLayerVisible}"
              TextWrapping="Wrap" />
          <TextBlock
              Grid.Row="6"
              Foreground="#AAB2BF"
              FontSize="12"
              Text="{Binding PreviewDetails}"
              IsVisible="{Binding IsMapInspector}"
              TextWrapping="Wrap" />
          <TextBlock
              Grid.Row="7"
              Foreground="#AAB2BF"
              FontSize="12"
              Text="{Binding MapGridHoverDisplay}"
              IsVisible="{Binding IsMapSquareGridVisible}"
              TextWrapping="Wrap" />
          <TextBlock
              Grid.Row="7"
              Foreground="#AAB2BF"
              FontSize="12"
              Text="Hex markers are diagnostic only; repeat-click stacked markers to cycle records."
              IsVisible="{Binding IsMapHexGridVisible}"
              TextWrapping="Wrap" />
          <StackPanel
              Grid.Row="7"
              IsVisible="{Binding IsMapFloorTileLayerVisible}"
              Spacing="2">
            <TextBlock
                Foreground="#AAB2BF"
                FontSize="12"
                Text="{Binding MapFloorTilesStatusDisplay}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="#AAB2BF"
                FontSize="11"
                Text="Colored markers show the square floor cell sampled by CE gravity; click to select, repeat-click to cycle stacked objects."
                TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock
            Grid.Row="7"
            Foreground="#AAB2BF"
            FontSize="12"
            Text="{Binding MapFloorTilesStatusDisplay}"
            IsVisible="{Binding IsMapIsometricFloorLayerVisible}"
            TextWrapping="Wrap" />
          <TextBlock
              Grid.Row="8"
              Foreground="#AAB2BF"
              FontSize="12"
              Text="{Binding PaletteStatus}"
              TextWrapping="Wrap" />
          <TextBlock
              Grid.Row="9"
              Foreground="#E7EAF0"
              FontWeight="SemiBold"
              Text="{Binding MapObjectStatusDisplay}"
              IsVisible="{Binding IsMapInspector}"
              TextWrapping="Wrap" />
          <ListBox
              Grid.Row="10"
              MaxHeight="120"
              ItemsSource="{Binding MapObjectPlacements}"
              SelectedItem="{Binding SelectedMapObject, Mode=TwoWay}"
              IsVisible="{Binding IsMapInspector}"
              AutomationProperties.Name="MAP object placements">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock
              Grid.Row="11"
              Foreground="#AAB2BF"
              FontSize="11"
              Text="{Binding MapObjectDetailsDisplay}"
              IsVisible="{Binding SelectedMapObject}"
              TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
