<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FalloutAssetExplorer.App.Views"
    x:Class="FalloutAssetExplorer.App.Views.MainWindow"
    Title="Fallout Asset Explorer"
    Width="1120"
    Height="720"
    MinWidth="760"
    MinHeight="480"
    Background="#171A1F"
    Foreground="#E7EAF0"
    FontFamily="Segoe UI">
  <TabControl
      x:Name="WorkspaceTabs"
      SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=TwoWay}">
    <TabItem Header="Archive Browser">
      <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open Archive..." Click="OpenArchive_Click" IsEnabled="{Binding CanOpenArchive}" />
        <MenuItem Header="Set _Game Data Folder..." Click="SetGameDataFolder_Click" />
        <MenuItem
            Header="Open Selected FRM in Sprite Explorer"
            Click="OpenSelectedFrmInSpriteExplorer_Click"
            IsEnabled="{Binding CanOpenSelectedFrmInSpriteExplorer}" />
        <MenuItem Header="_Extract Selected..." Click="ExtractSelected_Click" IsEnabled="{Binding CanExtractSelected}" />
        <MenuItem Header="Extract _Visible..." Click="ExtractVisible_Click" IsEnabled="{Binding CanExtractVisible}" />
        <MenuItem Header="Extract _All..." Click="ExtractAll_Click" IsEnabled="{Binding CanExtractAll}" />
        <Separator />
        <MenuItem
            Header="Export Selected FRM Spritesheets..."
            Click="ExportSelectedFrms_Click"
            IsEnabled="{Binding CanExportSelectedFrms}" />
        <MenuItem
            Header="Export Visible FRM Spritesheets..."
            Click="ExportVisibleFrms_Click"
            IsEnabled="{Binding CanExportVisibleFrms}" />
        <Separator />
        <MenuItem Header="Export _Selected..." IsEnabled="False" ToolTip.Tip="Available after archive reading and safe extraction are implemented." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Fallout Asset Explorer" Click="About_Click" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Padding="12,10" Background="#20242B">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Open Archive" Click="OpenArchive_Click" IsDefault="True" IsEnabled="{Binding CanOpenArchive}" />
        <Button Content="Extract Selected" Click="ExtractSelected_Click" IsEnabled="{Binding CanExtractSelected}" />
        <Button Content="Extract Visible" Click="ExtractVisible_Click" IsEnabled="{Binding CanExtractVisible}" />
        <Button Content="Extract All" Click="ExtractAll_Click" IsEnabled="{Binding CanExtractAll}" />
        <Button
            Content="Return to LST slot"
            IsEnabled="{Binding CanReturnToScriptList}"
            Click="ReturnToScriptList_Click"
            AutomationProperties.Name="Return to the originating script-list slot" />
        <TextBlock VerticalAlignment="Center" Text="Overwrite" />
        <ComboBox
            Width="150"
            ItemsSource="{Binding OverwritePolicyOptions}"
            SelectedIndex="{Binding SelectedOverwritePolicyIndex}"
            AutomationProperties.Name="Extraction overwrite policy" />
        <Border Width="1" Margin="2,0" Background="#3A414C" />
        <TextBlock VerticalAlignment="Center" Text="Search" />
        <TextBox
            Width="280"
            Watermark="Search resource paths..."
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding CanChangeArchiveSource}"
            AutomationProperties.Name="Search resource paths" />
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Type" />
        <ComboBox
            Width="130"
            ItemsSource="{Binding ExtensionOptions}"
            SelectedItem="{Binding SelectedExtension}"
            IsEnabled="{Binding CanChangeArchiveSource}"
            AutomationProperties.Name="Filter by extension" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#20242B" BorderBrush="#343A44" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,2*" ColumnSpacing="20">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Archive:" />
          <TextBlock Text="{Binding ArchivePathDisplay}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Format:" />
          <TextBlock Text="{Binding ArchiveFormatDisplay}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Entries:" />
          <TextBlock Text="{Binding EntryCountDisplay}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Selection:" />
          <TextBlock Text="{Binding SelectionDisplay}" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="#AAB2BF" Text="Game data:" />
          <TextBlock Text="{Binding GameDataDirectoryDisplay}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Margin="12,8" Padding="10,8" Background="#252A33" CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Button
            Grid.Column="1"
            Content="Cancel FRM export"
            IsVisible="{Binding CanCancelFrmExport}"
            Click="CancelFrmExport_Click" />
      </Grid>
    </Border>

    <Grid Margin="12,0,12,8" ColumnDefinitions="2*,*" ColumnSpacing="12">
      <DataGrid
          x:Name="EntriesGrid"
          Grid.Column="0"
          ItemsSource="{Binding VisibleEntries}"
          SelectionMode="Extended"
          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
          IsEnabled="{Binding CanChangeArchiveSource}"
          IsReadOnly="True"
          AutoGenerateColumns="False"
          CanUserSortColumns="True"
          GridLinesVisibility="Horizontal"
          HeadersVisibility="Column"
          SelectionChanged="EntriesGrid_SelectionChanged">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem
                Header="Copy Resource Path"
                IsEnabled="{Binding CanCopySelectedEntryPath}"
                Click="CopyResourcePath_Click" />
            <MenuItem
                Header="Open in Sprite Explorer"
                IsEnabled="{Binding CanOpenSelectedFrmInSpriteExplorer}"
                Click="OpenSelectedFrmInSpriteExplorer_Click" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Resource path/name" Binding="{Binding Path}" SortMemberPath="Path" Width="3*" />
          <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" SortMemberPath="Extension" Width="*" />
          <DataGridTextColumn Header="Uncompressed size" Binding="{Binding UncompressedSize}" SortMemberPath="UncompressedSize" Width="*" />
          <DataGridTextColumn Header="Compressed size" Binding="{Binding CompressedSize}" SortMemberPath="CompressedSize" Width="*" />
          <DataGridTextColumn Header="Archive location" Binding="{Binding ArchiveLocation}" SortMemberPath="ArchiveLocation" Width="2*" />
        </DataGrid.Columns>
      </DataGrid>

      <Border
          Grid.Column="0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Padding="12"
          Background="#20242B"
          IsVisible="{Binding IsFilterResultEmpty}"
          IsHitTestVisible="False"
          AutomationProperties.Name="No resources match the current filters">
        <TextBlock Text="No results match the current filters." />
      </Border>

      <Border
          x:Name="PreviewPane"
          Grid.Column="1"
          Padding="12"
          Background="#20242B"
          BorderBrush="#343A44"
          BorderThickness="1"
          CornerRadius="4">
        <Grid
            x:Name="PreviewLayoutGrid"
            RowDefinitions="Auto,Auto,*,6,*"
            RowSpacing="4">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding PreviewTitle}" />
            <Button
                Grid.Column="1"
                Content="Export PNG..."
                Click="ExportPng_Click"
                IsEnabled="{Binding FrmPreview.CanExportPng}"
                AutomationProperties.Name="Export selected FRM frame as PNG" />
            <Button
                Grid.Column="2"
                Content="Export current FRM spritesheet..."
                Click="ExportSpritesheet_Click"
                IsEnabled="{Binding FrmPreview.CanExportSpritesheet}"
                AutomationProperties.Name="Export the current FRM entry's directions and frames as a spritesheet PNG" />
            <Button
                Grid.Column="3"
                Content="Export report..."
                Click="ExportStandaloneProReport_Click"
                IsVisible="{Binding IsProInspector}"
                IsEnabled="{Binding CanExportStandaloneProReport}"
                AutomationProperties.Name="Export PRO inspection report" />
            <Button
                Grid.Column="4"
                Content="Export raw BIN..."
                Click="ExportStandaloneProRawBin_Click"
                IsVisible="{Binding IsProInspector}"
                IsEnabled="{Binding CanExportStandaloneProRawBin}"
                AutomationProperties.Name="Export exact raw PRO bytes" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding PreviewMessage}" TextWrapping="Wrap" />
          <Grid
              x:Name="MapViewportGrid"
              Grid.Row="2"
              RowDefinitions="*,Auto,Auto"
              RowSpacing="4"
              MinHeight="56">
            <Border Grid.Row="0" Background="#171A1F" ClipToBounds="True" MinHeight="32">
              <Grid IsVisible="{Binding FrmPreview.HasPreview}">
                <local:CheckerboardBackground
                    IsVisible="{Binding FrmPreview.IsCheckerboardBackground}"
                    IsHitTestVisible="False" />
                <Image
                    Source="{Binding FrmPreview.PreviewBitmap}"
                    Stretch="Uniform"
                    RenderOptions.BitmapInterpolationMode="None"
                    AutomationProperties.Name="FRM color preview" />
              </Grid>
            </Border>
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8"
                IsVisible="{Binding FrmPreview.HasPreview}">
              <TextBlock VerticalAlignment="Center" Text="Direction" />
              <ComboBox
                  Width="130"
                  ItemsSource="{Binding FrmPreview.DirectionOptions}"
                  SelectedIndex="{Binding FrmPreview.SelectedDirectionIndex}"
                  IsEnabled="{Binding FrmPreview.HasPreview}"
                  AutomationProperties.Name="FRM direction" />
              <TextBlock VerticalAlignment="Center" Text="Frame" />
              <ComboBox
                  Width="90"
                  ItemsSource="{Binding FrmPreview.FrameOptions}"
                  SelectedItem="{Binding FrmPreview.SelectedFrameIndex}"
                  IsEnabled="{Binding FrmPreview.HasPreview}"
                  AutomationProperties.Name="FRM frame" />
              <CheckBox
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  Content="Checkerboard"
                  IsChecked="{Binding FrmPreview.IsCheckerboardBackground}"
                  IsEnabled="{Binding FrmPreview.HasPreview}"
                  AutomationProperties.Name="Checkerboard transparency background" />
            </StackPanel>
            <Grid
                Grid.Row="2"
                ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                ColumnSpacing="8"
                IsVisible="{Binding FrmPreview.HasPreview}">
              <Button
                  Content="{Binding FrmPreview.PlayPauseButtonText}"
                  Click="TogglePlayback_Click"
                  IsEnabled="{Binding FrmPreview.CanPlay}"
                  AutomationProperties.Name="Play or pause FRM animation" />
              <CheckBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Content="Loop"
                  IsChecked="{Binding FrmPreview.IsLoopEnabled}"
                  IsEnabled="{Binding FrmPreview.CanPlay}"
                  AutomationProperties.Name="Loop FRM animation" />
              <TextBlock
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Text="{Binding FrmPreview.CurrentFrameDisplay}"
                  AutomationProperties.Name="Current FRM frame" />
              <TextBlock
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Text="Preview FPS" />
              <Slider
                  Grid.Column="4"
                  Minimum="1"
                  Maximum="30"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  Value="{Binding FrmPreview.PlaybackSpeed}"
                  AutomationProperties.Name="FRM preview playback speed" />
              <TextBlock
                  Grid.Column="5"
                  VerticalAlignment="Center"
                  Text="{Binding FrmPreview.PlaybackSpeedDisplay}" />
            </Grid>
          </Grid>
          <GridSplitter
              x:Name="PreviewWorkspaceSplitter"
              Grid.Row="3"
              Height="6"
              HorizontalAlignment="Stretch"
              Background="#3A414C"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              AutomationProperties.Name="Resize MAP canvas and inspector workspace" />
          <Grid
              x:Name="InspectorWorkspaceGrid"
              Grid.Row="4"
              RowDefinitions="*,6,*"
              RowSpacing="4"
              MinHeight="100">
            <ScrollViewer
                Grid.Row="0"
                Grid.RowSpan="3"
                IsVisible="{Binding FrmPreview.HasPreview}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="8">
                <TextBlock
                    Foreground="#AAB2BF"
                    FontSize="12"
                    Text="{Binding FrmPreview.PreviewDetails}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="#AAB2BF"
                    FontSize="12"
                    Text="{Binding PaletteStatus}"
                    TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Border
              x:Name="StandaloneProInspector"
              Grid.Row="2"
              Grid.RowSpan="3"
              Padding="10"
              Background="#20242B"
              IsVisible="{Binding IsProInspector}"
              AutomationProperties.Name="Standalone Fallout 2 PRO inspector">
            <Grid RowDefinitions="Auto,Auto,*,6,*" RowSpacing="6">
              <TextBlock
                  Grid.Row="0"
                  FontWeight="SemiBold"
                  Text="{Binding StandaloneProStatus}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Grid.Row="1"
                  FontFamily="Consolas"
                  FontSize="11"
                  Text="{Binding StandaloneProDetails}"
                  TextWrapping="Wrap" />
              <ScrollViewer
                  Grid.Row="2"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="11"
                    Text="{Binding StandaloneProFieldsDisplay}"
                    TextWrapping="Wrap" />
              </ScrollViewer>
              <GridSplitter
                  Grid.Row="3"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  Background="#3A414C"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  AutomationProperties.Name="Resize PRO fields and raw bytes" />
              <ListBox
                  Grid.Row="4"
                  ItemsSource="{Binding StandaloneProRawByteLines}"
                  IsVisible="{Binding HasStandaloneProRawBytes}"
                  VerticalAlignment="Stretch"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Raw standalone PRO bytes">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="10"
                        Text="{Binding}"
                        TextWrapping="NoWrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border
              x:Name="IntInspector"
              Grid.Row="2"
              Grid.RowSpan="3"
              Padding="10"
              Background="#20242B"
              IsVisible="{Binding IsIntInspector}"
              AutomationProperties.Name="INT metadata inspector">
            <Grid RowDefinitions="Auto,Auto,Auto,2*,Auto,*" RowSpacing="6">
              <TextBlock
                  Grid.Row="0"
                  FontWeight="SemiBold"
                  Text="{Binding IntStatus}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Grid.Row="1"
                  Foreground="#E7A86A"
                  Text="{Binding IntDiagnosticDisplay}"
                  TextWrapping="Wrap"
                  IsVisible="{Binding HasIntDiagnostic}" />
              <TextBlock
                  Grid.Row="2"
                  Text="{Binding IntProcedureCountDisplay}" />
              <Grid
                  Grid.Row="3"
                  RowDefinitions="Auto,*"
                  RowSpacing="4">
                <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="4">
                  <TextBlock FontFamily="Consolas" Text="RawField0" />
                  <TextBlock Grid.Column="1" FontFamily="Consolas" Text="RawField4" />
                  <TextBlock Grid.Column="2" FontFamily="Consolas" Text="RawField8" />
                  <TextBlock Grid.Column="3" FontFamily="Consolas" Text="RawField12" />
                  <TextBlock Grid.Column="4" FontFamily="Consolas" Text="RawField16" />
                  <TextBlock Grid.Column="5" FontFamily="Consolas" Text="RawField20" />
                </Grid>
                <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding IntMetadataReadResult.Metadata.Procedures}"
                    VerticalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Raw INT procedure fields">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="4">
                        <TextBlock FontFamily="Consolas" Text="{Binding RawField0}" />
                        <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{Binding RawField4}" />
                        <TextBlock Grid.Column="2" FontFamily="Consolas" Text="{Binding RawField8}" />
                        <TextBlock Grid.Column="3" FontFamily="Consolas" Text="{Binding RawField12}" />
                        <TextBlock Grid.Column="4" FontFamily="Consolas" Text="{Binding RawField16}" />
                        <TextBlock Grid.Column="5" FontFamily="Consolas" Text="{Binding RawField20}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
              <TextBlock
                  Grid.Row="4"
                  Text="Raw length-prefixed identifier table bytes (hex; offsets are relative to this display):"
                  TextWrapping="Wrap" />
              <ScrollViewer
                  Grid.Row="5"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="11"
                    Text="{Binding IntIdentifierTableHex}"
                    TextWrapping="NoWrap"
                    AutomationProperties.Name="Raw INT identifier table bytes in hexadecimal" />
              </ScrollViewer>
            </Grid>
          </Border>
          <Border
              x:Name="ScriptListInspector"
              Grid.Row="2"
              Grid.RowSpan="3"
              Padding="10"
              Background="#20242B"
              IsVisible="{Binding IsScriptListInspector}"
              AutomationProperties.Name="Script list slot inspector">
            <Grid RowDefinitions="Auto,Auto,Auto,2*,Auto,*" RowSpacing="6">
              <TextBlock
                  Grid.Row="0"
                  FontWeight="SemiBold"
                  Text="{Binding ScriptListStatus}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Grid.Row="1"
                  FontFamily="Consolas"
                  FontSize="11"
                  Text="{Binding ScriptListDetails}"
                  TextWrapping="Wrap" />
              <Grid
                  Grid.Row="2"
                  ColumnDefinitions="65,100,*,*"
                  ColumnSpacing="8">
                <TextBlock FontSize="11" Text="Slot (zero-based)" />
                <TextBlock Grid.Column="1" FontSize="11" Text="State" />
                <TextBlock Grid.Column="2" FontSize="11" Text="Parsed name" />
                <TextBlock Grid.Column="3" FontSize="11" Text="INT path candidate" />
              </Grid>
              <ListBox
                  Grid.Row="3"
                  ItemsSource="{Binding ScriptListSlots}"
                  SelectedItem="{Binding SelectedScriptListSlot, Mode=TwoWay}"
                  VerticalAlignment="Stretch"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Script list slots in source order">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="65,100,*,*" ColumnSpacing="8">
                      <TextBlock FontFamily="Consolas" Text="{Binding Slot}" />
                      <TextBlock Grid.Column="1" Text="{Binding Status}" />
                      <TextBlock Grid.Column="2" Text="{Binding ScriptName}" TextWrapping="Wrap" />
                      <TextBlock
                          Grid.Column="3"
                          Text="{Binding IntPathCandidate}"
                          TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid
                  Grid.Row="4"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding ScriptListIntTargetDetails}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Content="Open verified INT"
                    IsEnabled="{Binding CanNavigateToSelectedScriptInt}"
                    Click="NavigateToScriptInt_Click"
                    AutomationProperties.Name="Open the uniquely matched INT entry" />
              </Grid>
              <ScrollViewer
                  Grid.Row="5"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="11"
                    Text="{Binding SelectedScriptListSlotRawHex}"
                    TextWrapping="NoWrap"
                    AutomationProperties.Name="Selected script-list slot raw bytes in hexadecimal" />
              </ScrollViewer>
            </Grid>
          </Border>
          <local:MapInspectorView
              x:Name="MapInspectorControl"
              Grid.Row="2"
              Grid.RowSpan="3"
              IsVisible="{Binding IsMapInspector}" />
        </Grid>
      </Border>
    </Grid>
      </DockPanel>
    </TabItem>
    <TabItem Header="Sprite Explorer">
      <local:SpriteExplorerView DataContext="{Binding SpriteExplorer}" />
    </TabItem>
    <TabItem Header="MSG Editor">
      <Grid Margin="12" ColumnDefinitions="250,6,*">
        <Border
            Grid.Column="0"
            Padding="10"
            Background="#20242B"
            AutomationProperties.Name="MSG file browser">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
            <TextBlock
                FontWeight="SemiBold"
                Text="MSG files in active archive" />
            <TextBlock
                Grid.Row="1"
                FontSize="11"
                Text="{Binding ArchivePathDisplay}"
                TextTrimming="CharacterEllipsis"
                AutomationProperties.Name="Active MSG archive source" />
            <TextBox
                Grid.Row="2"
                Text="{Binding MsgFileSearchText, UpdateSourceTrigger=PropertyChanged}"
                Watermark="Filter filename or path..."
                AutomationProperties.Name="Filter MSG files by filename or archive path" />
            <TextBlock
                Grid.Row="3"
                Text="{Binding MsgFileBrowserStatus}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                Grid.Row="4"
                FontSize="10"
                Foreground="#AAB2BF"
                Text=".MSG extension candidates are parsed when selected."
                TextWrapping="Wrap" />
            <ListBox
                x:Name="MsgFilesList"
                Grid.Row="5"
                ItemsSource="{Binding VisibleMsgFiles}"
                SelectedItem="{Binding SelectedMsgFile, Mode=OneWay}"
                IsEnabled="{Binding CanChangeArchiveSource}"
                SelectionChanged="MsgFilesList_SelectionChanged"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                AutomationProperties.Name="MSG files in the active archive">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,6" Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding FileName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="10"
                        Foreground="#AAB2BF"
                        Text="{Binding ArchiveRelativePath}"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
        <GridSplitter
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Stretch"
            Background="#3A414C"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            AutomationProperties.Name="Resize MSG file browser" />
        <Grid Grid.Column="2">
          <Border
            x:Name="MsgInspector"
            Padding="10"
            Background="#20242B"
            IsVisible="{Binding IsMsgInspector}"
            AutomationProperties.Name="MSG inspector">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,2*,Auto,Auto,2*,2*,Auto,Auto,Auto,*" RowSpacing="6">
            <TextBlock
                Grid.Row="0"
                FontWeight="SemiBold"
                Text="{Binding MsgStatus}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="1"
                FontFamily="Consolas"
                FontSize="11"
                Text="{Binding MsgDetails}"
                TextWrapping="Wrap" />
            <Grid
                Grid.Row="2"
                ColumnDefinitions="Auto,150,*"
                ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="Message ID" />
              <TextBox
                  x:Name="MsgIdFilterInput"
                  Grid.Column="1"
                  Text="{Binding MsgInspector.IdFilterText, UpdateSourceTrigger=PropertyChanged}"
                  IsEnabled="{Binding MsgInspector.CanChangeSelection}"
                  Watermark="Any signed 32-bit ID"
                  AutomationProperties.Name="Filter messages by numeric ID" />
              <TextBlock
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Text="{Binding MsgInspector.FilterStatus}"
                  TextWrapping="Wrap" />
            </Grid>
            <Grid
                Grid.Row="3"
                ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                ColumnSpacing="8">
              <TextBlock FontSize="11" Text="Position" />
              <TextBlock Grid.Column="1" FontSize="11" Text="ID" />
              <TextBlock Grid.Column="2" FontSize="11" Text="Text snippet" />
              <TextBlock Grid.Column="3" FontSize="11" Text="Audio bytes" />
              <TextBlock Grid.Column="4" FontSize="11" Text="Text bytes" />
            </Grid>
            <ListBox
                x:Name="MsgEntryList"
                Grid.Row="4"
                ItemsSource="{Binding MsgInspector.VisibleMessages}"
                SelectedItem="{Binding MsgInspector.SelectedMessage, Mode=TwoWay}"
                IsEnabled="{Binding MsgInspector.CanChangeSelection}"
                VerticalAlignment="Stretch"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                AutomationProperties.Name="MSG entries in source order, including duplicate IDs">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock FontFamily="Consolas" Text="{Binding Position}" />
                    <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{Binding Id}" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{Binding TextSnippet}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" FontFamily="Consolas" Text="{Binding AudioLength}" />
                    <TextBlock Grid.Column="4" FontFamily="Consolas" Text="{Binding TextLength}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid
                Grid.Row="5"
                ColumnDefinitions="Auto,180,*"
                ColumnSpacing="8">
              <TextBlock
                  VerticalAlignment="Center"
                  Text="Text encoding" />
              <ComboBox
                  x:Name="MsgTextEncodingSelector"
                  Grid.Column="1"
                  ItemsSource="{Binding MsgInspector.TextEncodingOptions}"
                  SelectedItem="{Binding MsgInspector.SelectedTextEncoding, Mode=TwoWay}"
                  IsEnabled="{Binding MsgInspector.CanSelectTextEncoding}"
                  AutomationProperties.Name="Select MSG text encoding">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <Grid
                Grid.Row="6"
                ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                ColumnSpacing="8">
              <Button
                  x:Name="BeginMsgTextEditButton"
                  Content="Begin Edit"
                  Click="BeginMsgTextEdit_Click"
                  IsEnabled="{Binding MsgInspector.CanBeginEdit}" />
              <Button
                  x:Name="ApplyMsgTextEditButton"
                  Grid.Column="1"
                  Content="Apply"
                  Click="ApplyMsgTextEdit_Click"
                  IsEnabled="{Binding MsgInspector.CanApplyEdit}" />
              <Button
                  x:Name="CancelMsgTextEditButton"
                  Grid.Column="2"
                  Content="Cancel"
                  Click="CancelMsgTextEdit_Click"
                  IsEnabled="{Binding MsgInspector.CanCancelEdit}" />
              <Button
                  x:Name="SaveMsgAsButton"
                  Grid.Column="3"
                  Content="Save As..."
                  Click="SaveMsgAs_Click"
                  IsEnabled="{Binding MsgInspector.CanSaveAs}" />
            </Grid>
            <Grid
                Grid.Row="7"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="4">
              <TextBlock
                  FontWeight="SemiBold"
                  Text="Read-only source text preview" />
              <TextBlock
                  Grid.Row="1"
                  Text="{Binding MsgInspector.TextPreviewStatus}"
                  TextWrapping="Wrap" />
              <TextBox
                  x:Name="MsgTextPreview"
                  Grid.Row="2"
                  Text="{Binding MsgInspector.TextPreview, Mode=OneWay}"
                  IsReadOnly="True"
                  IsVisible="{Binding MsgInspector.CanShowTextPreview}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  VerticalAlignment="Stretch"
                  MinHeight="80"
                  AutomationProperties.Name="Read-only decoded MSG source text preview" />
            </Grid>
            <Grid
                Grid.Row="8"
                RowDefinitions="Auto,*"
                RowSpacing="4">
              <TextBlock
                  FontWeight="SemiBold"
                  Text="Editable text draft" />
              <TextBox
                  x:Name="MsgTextDraftEditor"
                  Grid.Row="1"
                  Text="{Binding MsgInspector.DraftText, UpdateSourceTrigger=PropertyChanged}"
                  IsEnabled="{Binding MsgInspector.CanEditDraft}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  VerticalAlignment="Stretch"
                  MinHeight="80"
                  Watermark="Begin Edit to create a draft."
                  AutomationProperties.Name="Editable MSG text draft" />
            </Grid>
            <TextBlock
                Grid.Row="9"
                Text="{Binding MsgInspector.EditStatus}"
                TextWrapping="Wrap"
                AutomationProperties.Name="MSG text editing status" />
            <TextBlock
                Grid.Row="10"
                Text="{Binding MsgInspector.PatchedOutputStatus}"
                TextWrapping="Wrap"
                AutomationProperties.Name="MSG output save status" />
            <StackPanel
                Grid.Row="11"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">
              <TextBlock VerticalAlignment="Center" Text="Raw field" />
              <ComboBox
                  Width="100"
                  ItemsSource="{Binding MsgInspector.PayloadFields}"
                  SelectedItem="{Binding MsgInspector.SelectedPayloadField}"
                  AutomationProperties.Name="Choose raw MSG field" />
              <TextBlock
                  VerticalAlignment="Center"
                  Text="{Binding MsgInspector.SelectedPayloadStatus}"
                  TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer
                Grid.Row="12"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
              <TextBlock
                  FontFamily="Consolas"
                  FontSize="11"
                  Text="{Binding MsgInspector.SelectedPayloadHex}"
                  TextWrapping="NoWrap"
                  AutomationProperties.Name="Selected MSG field bytes in hexadecimal" />
            </ScrollViewer>
          </Grid>
        </Border>
          <TextBlock
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="Select a .MSG file in the browser or Archive Browser to open it here."
            TextWrapping="Wrap"
            IsVisible="{Binding IsMsgEditorEmpty}" />
        </Grid>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
